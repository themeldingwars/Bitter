<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Information -->
    <PackageId>TMW.Bitter</PackageId>
    <Title>Bitter</Title>
    <Authors>freakbyte</Authors>
    <Company>The Melding Wars</Company>
    <Product>Bitter</Product>
    <Description>A .NET Standard 2.0 / .NET 8 library for manipulating binary data</Description>
    <PackageTags>binary;byte;bits</PackageTags>
    <PackageProjectUrl>https://github.com/freakbyte/Bitter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/themeldingwars/Bitter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright © 2018-2026 freakbyte and The Melding Wars contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
